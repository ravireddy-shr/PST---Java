#include <vector>
using namespace std;

class Solution {
public:
    vector<int> sortArrayByParity(vector<int>& nums) {
        int left = 0;
        int right = nums.size() - 1;
        
        while (left < right) {
            // Even at left position - move forward
            if (nums[left] % 2 == 0) {
                left++;
            }
            // Odd at right position - move backward  
            else if (nums[right] % 2 != 0) {
                right--;
            }
            // Swap odd from left with even from right
            else {
                swap(nums[left], nums[right]);
                left++;
                right--;
            }
        }
        
        return nums;
    }
};
